[*]
encoding           = UTF-8
error.channel      = rasr.recog.log
log.channel        = rasr.recog.log
statistics.channel = rasr.recog.log
unbuffered         = no
warning.channel    = rasr.recog.log

[lib-rasr]
lexicon.file = /work/smt4/azim.javed/sisyphus_work/data/base/RemovePhonemeVariationsFromLexiconJob.ErKAJLvOCASq/output/lexicon.xml.gz
lm.scale     = 0.0

[lib-rasr.acoustic-model]
state-tying.type = monophone

[lib-rasr.acoustic-model.allophones]
add-all          = no
add-from-lexicon = yes

[lib-rasr.acoustic-model.hmm]
across-word-model   = yes
early-recombination = no
state-repetitions   = 1
states-per-phone    = 1

[lib-rasr.acoustic-model.phonology]
future-length  = 0
history-length = 0

[lib-rasr.acoustic-model.tdp]
entry-m1.loop = infinity
entry-m2.loop = infinity
scale         = 1.0

[lib-rasr.acoustic-model.tdp.*]
exit    = 0.0
forward = 0.0
loop    = 0.0
skip    = infinity

[lib-rasr.acoustic-model.tdp.silence]
exit    = 0.0
forward = 0.0
loop    = 0.0
skip    = infinity

[lib-rasr.label-scorer]
history-length    = 1
max-batch-size    = 2048
start-label-index = 184
type              = fixed-context-py

[lib-rasr.label-scorer.recognition]
blank-penalty = 0.0
device = cuda
ilm-scale     = 0.0
imports       = from recipe.model_pipelines.qat_ffnn_transducer.pytorch_modules import QATFFNNTransducerScorer as ScorerModel from recipe.model_pipelines.qat_ffnn_transducer.pytorch_modules import QATFFNNTransducerRecogConfig as RecogConfig from recipe.experiments.librispeech.training.qat_ffnn_transducer_bpe import get_model_config as get_model_config
model-path    = /work/smt4/azim.javed/sisyphus_work/i6_core/returnn/training/ReturnnTrainingJob.s9sXAl53j9fG/output/models/epoch.2000.pt
scale         = 1.0

[lib-rasr.label-scorer.recognition.qat]
activation-bit-prec = 8
weight-bit-prec     = 8
weight-dropout      = 0.0

[lib-rasr.search-algorithm]
allow-blank-after-sentence-end      = no
collapse-repeated-labels            = no
force-blank-between-repeated-labels = no
log-stepwise-statistics             = yes
max-beam-size                       = 1024
score-threshold                     = 18.0
sentence-end-fall-back              = yes
tree-builder-type                   = rna
type                                = tree-timesync-beam-search