[*]
encoding           = UTF-8
error.channel      = rasr.recog.log
log.channel        = rasr.recog.log
statistics.channel = rasr.recog.log
unbuffered         = no

[lib-rasr]
lexicon.file = vocab-text:/work/smt4/azim.javed/sisyphus_work/data/base/BPEVocabToTextFileConversionJob.VXy4HsOOBooi/output/vocab.txt

[lib-rasr.label-scorer]
history-length    = 1
max-batch-size    = 2048
start-label-index = 184
type              = fixed-context-py-cache

[lib-rasr.label-scorer.recognition]
blank-penalty = 0.0
device = cuda
ilm-scale     = 0.0
imports       = from recipe.model_pipelines.ffnn_transducer_qat_encoder_pred.mem_inited.pytorch_modules import FFNNTransducerQATEncoderPredictionScorer as ScorerModel from recipe.model_pipelines.ffnn_transducer_qat_encoder_pred.mem_inited.pytorch_modules import FFNNTransducerQATEncoderPredictionRecogConfig as RecogConfig from recipe.experiments.librispeech.training.ffnn_transducer_qat_encoder_prediction_bpe import get_model_config as get_model_config
model-path    = /work/smt4/azim.javed/sisyphus_work/model_pipelines/common/memrecog/MemristorModelConversionJob.dM4lrkM4hNZa/output/memristor_converted_model.pt
scale         = 1.0

[lib-rasr.label-scorer.recognition.memristor]
converter-hardware-settings         = 8 4 4 0.6 8020.0
num-cycles                          = 1
pos-enc-converter-hardware-settings = 8 1 7 0.6 8020.0

[lib-rasr.label-scorer.recognition.qat]
activation-bit-prec = 8
weight-bit-prec     = 8
weight-dropout      = 0.0

[lib-rasr.search-algorithm]
allow-blank-after-sentence-end = no
blank-label-index              = 184
collapse-repeated-labels       = no
log-stepwise-statistics        = yes
max-beam-size                  = 1
score-threshold                = 0.0
type                           = lexiconfree-timesync-beam-search