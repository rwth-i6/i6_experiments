@@ -480,7 +480,11 @@ def assign_obj_attribs(obj, d: Dict[str, Any]):
 
 
 def make_numpy_ndarray_fromstring(s, dtype, shape):
-    return numpy.fromstring(s, dtype=dtype).reshape(shape)
+    # numpy >= 1.22 removed fromstring's binary mode (unconditional ValueError), so under the
